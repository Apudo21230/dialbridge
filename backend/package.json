{
  "name": "@dialbridge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "NODE_ENV=test DATABASE_URL=postgresql://apple@localhost:5432/dialbridge_test vitest run",
    "test:watch": "NODE_ENV=test DATABASE_URL=postgresql://apple@localhost:5432/dialbridge_test vitest",
    "db:seed-admin": "tsx src/db/seedAdmin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
