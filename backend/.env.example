# Copy to .env (gitignored). NEVER commit real secrets — everything lives here.

# Database
DATABASE_URL=postgresql://apple@localhost:5432/dialbridge_dev

# Secrets (>= 16 chars; fail-closed in production)
JWT_SECRET=change-me-strong-jwt-secret-min-16-chars
WEBHOOK_SECRET=change-me-strong-webhook-secret-min-16-chars

PORT=3000

# Recording storage (S3) — recordings are sensitive; use a PRIVATE bucket in production.
# Credentials are read from the standard AWS env chain.
AWS_REGION=ap-south-1
AWS_BUCKET=your-bucket
AWS_FOLDER=Dialbridge/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payments (later) — Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
